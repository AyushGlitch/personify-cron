# Copy to .env and fill in your values:
#   cp .env.example .env

PERSONIFY_EMAIL=you@company.com
PERSONIFY_PASSWORD=your-password

# Primary flow: home (Healthy Habits on dashboard). Secondary: stats (legacy stats page).
FLOW=home

# Random steps each run (home + stats flows)
STEPS_MIN=7001
STEPS_MAX=21000
# Or fixed steps (leave MIN/MAX blank):
# DAILY_STEPS=10000

# Sleep: random total hours between min and max (home flow splits into h + m)
SLEEP_HOURS_MIN=7
SLEEP_HOURS_MAX=10

# Mood: one picked at random each run (home flow)
MOODS=angry,sad,worried,unsure,happy,excited

PERSONIFY_LOGIN_URL=https://app.personifyhealth.com
HEADLESS=1

# --- Login ---
SELECTOR_EMAIL=placeholder:Enter your email or username
SELECTOR_CONTINUE=role:button:Continue
SELECTOR_PASSWORD=placeholder:Enter your password
SELECTOR_SIGN_IN=role:button:Sign In

# --- Home flow (primary) ---
HOME_PAGE_URL=https://app.personifyhealth.com/#/home
SELECTOR_HEALTHY_HABITS=label:Healthy Habits
SELECTOR_SLEEP_HOURS_INPUT=#sleepHours, aria-label:Enter hours of sleep, formcontrolname:hours
SELECTOR_SLEEP_MINUTES_INPUT=#sleepMinutes, aria-label:Enter minutes of sleep, formcontrolname:minutes
SELECTOR_TRACK_SLEEP=#track-sleep-cmx, [id*='track-sleep']
SELECTOR_STEPS_INPUT_HOME=placeholder:Enter number of steps
SELECTOR_TRACK_STEPS=#track-steps-cmx
SELECTOR_DAILY_CARD_OK=#daily-card-actions, role:button:OK

# --- Stats flow (secondary / legacy) ---
STATS_PAGE_URL=https://app.personifyhealth.com/#/stats-page
SELECTOR_STEPS_NAV=label:Track Steps, role:link:Track Steps
SELECTOR_STEPS_INPUT=placeholder:Enter number of steps
SELECTOR_STEPS_SAVE=role:button:Save
SELECTOR_SLEEP_NAV=label:Track Sleep, role:link:Track Sleep
SELECTOR_SLEEP_INPUT=#sleepHours, aria-label:Enter hours of sleep, formcontrolname:hours
SELECTOR_SLEEP_SAVE=role:button:Save
