# Copy to .env and fill in your values:
#   cp .env.example .env

PERSONIFY_EMAIL=you@company.com
PERSONIFY_PASSWORD=your-password

DAILY_STEPS=10372

# Sleep: random value between min and max each run (hours)
SLEEP_HOURS_MIN=7
SLEEP_HOURS_MAX=8
# Or set a fixed value instead (leave MIN/MAX blank):
# SLEEP_HOURS=7.5

PERSONIFY_LOGIN_URL=https://app.personifyhealth.com
HEADLESS=1

# --- Login ---
SELECTOR_EMAIL=placeholder:Enter your email or username
SELECTOR_CONTINUE=role:button:Continue
SELECTOR_PASSWORD=placeholder:Enter your password
SELECTOR_SIGN_IN=role:button:Sign In

# --- Stats page ---
STATS_PAGE_URL=https://app.personifyhealth.com/#/stats-page

# Steps
SELECTOR_STEPS_NAV=label:Track Steps, role:link:Track Steps
SELECTOR_STEPS_INPUT=placeholder:Enter number of steps
SELECTOR_STEPS_SAVE=role:button:Save

# Sleep — single "Enter Total" field
SELECTOR_SLEEP_NAV=label:Track Sleep, role:link:Track Sleep
SELECTOR_SLEEP_INPUT=placeholder:Enter hours of sleep
SELECTOR_SLEEP_SAVE=role:button:Save
