# Copy to .env and fill in your values:
#   cp .env.example .env

PERSONIFY_EMAIL=you@company.com
PERSONIFY_PASSWORD=your-password

# Values to log each day (override in GitHub Secrets for CI)
DAILY_STEPS=8500
SLEEP_HOURS=7
SLEEP_MINUTES=30

# Login page — adjust if your employer uses a custom URL
PERSONIFY_LOGIN_URL=https://login.personifyhealth.com

# Set to 0 for visible browser while debugging selectors locally
HEADLESS=1

# --- Selectors (fill in after running: playwright codegen $PERSONIFY_LOGIN_URL) ---
# Use CSS selectors or Playwright text/role selectors.

SELECTOR_EMAIL=input[name="username"], input[type="email"], #username
SELECTOR_PASSWORD=input[name="password"], input[type="password"], #password
SELECTOR_SIGN_IN=button[type="submit"], button:has-text("Sign In")

# Optional: direct URLs after login (faster than clicking through menus)
STEPS_PAGE_URL=
SLEEP_PAGE_URL=

SELECTOR_STEPS_INPUT=
SELECTOR_STEPS_SAVE=

SELECTOR_SLEEP_HOURS_INPUT=
SELECTOR_SLEEP_MINUTES_INPUT=
SELECTOR_SLEEP_SAVE=

# Optional: menu navigation if page URLs are unknown
SELECTOR_STEPS_NAV=
SELECTOR_SLEEP_NAV=
